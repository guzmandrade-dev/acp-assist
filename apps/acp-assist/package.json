{
  "name": "acp-assist-unified",
  "version": "1.7.1",
  "description": "ACP Assist: ONE companion app bundling the LyX, LibreOffice, and ONLYOFFICE assistants with an in-app switcher.",
  "author": {
    "name": "guzmandrade-dev",
    "email": "117118816+guzmandrade-dev@users.noreply.github.com"
  },
  "type": "module",
  "main": "./dist/electron/main.js",
  "scripts": {
    "build": "npm run build -w @acp-assist/panel -w @acp-assist/core -w lyx-acp-assist -w libreoffice-acp-assist -w onlyoffice-acp-assist && tsc && tsc -p tsconfig.preload.json",
    "dev": "tsc --watch",
    "typecheck": "npm run build -w @acp-assist/panel -w @acp-assist/core -w lyx-acp-assist -w libreoffice-acp-assist -w onlyoffice-acp-assist && tsc --noEmit",
    "start": "npm run build && electron ./dist/electron/main.js",
    "test": "npm run build -w @acp-assist/panel -w @acp-assist/core -w lyx-acp-assist -w libreoffice-acp-assist -w onlyoffice-acp-assist && vitest run",
    "test:watch": "vitest",
    "package:oxt": "npm run package:oxt -w libreoffice-acp-assist",
    "package:plugin": "npm run package:plugin -w onlyoffice-acp-assist",
    "package": "npm run build && npm run package:oxt && npm run package:plugin && electron-builder --publish never"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guzmandrade-dev/acp-assist.git",
    "directory": "apps/acp-assist"
  },
  "homepage": "https://github.com/guzmandrade-dev/acp-assist#readme",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "electron": "44.9.3",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.4.0",
    "@acp-assist/core": "*",
    "@acp-assist/panel": "*",
    "lyx-acp-assist": "*",
    "libreoffice-acp-assist": "*",
    "onlyoffice-acp-assist": "*",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "build": {
    "appId": "com.guzma.acp-assist",
    "productName": "ACP Assist",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "build/icon-256.png",
      "build/icon.ico",
      "!test/**"
    ],
    "extraResources": [
      {
        "from": "../libreoffice/acp-bridge.oxt",
        "to": "acp-bridge.oxt"
      },
      {
        "from": "../onlyoffice/acp-bridge.plugin",
        "to": "acp-bridge.plugin"
      }
    ],
    "icon": "build/icon.ico",
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "Office",
      "icon": "build/icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Office",
      "icon": "build/icon-256.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
