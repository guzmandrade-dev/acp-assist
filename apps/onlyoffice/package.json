{
  "name": "onlyoffice-acp-assist",
  "version": "0.1.0",
  "description": "Copilot-for-Word-style LLM assistant for ONLYOFFICE Desktop Editors: ACP agent companion with an in-editor plugin bridge.",
  "author": {
    "name": "guzmandrade-dev",
    "email": "117118816+guzmandrade-dev@users.noreply.github.com"
  },
  "type": "module",
  "main": "./dist/electron/main.js",
  "scripts": {
    "build": "npm run build -w @acp-assist/panel && npm run build -w @acp-assist/core && tsc && tsc -p tsconfig.preload.json",
    "dev": "tsc --watch",
    "typecheck": "npm run build -w @acp-assist/panel && npm run build -w @acp-assist/core && tsc --noEmit",
    "start": "npm run build && electron ./dist/electron/main.js",
    "test": "npm run build -w @acp-assist/panel && npm run build -w @acp-assist/core && vitest run",
    "test:watch": "vitest",
    "package:plugin": "node scripts/package-plugin.mjs",
    "package": "npm run build && npm run package:plugin && electron-builder --publish never"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guzmandrade-dev/acp-assist.git",
    "directory": "apps/onlyoffice"
  },
  "homepage": "https://github.com/guzmandrade-dev/acp-assist#readme",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "electron": "45.2.3",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.guzma.onlyoffice-acp-assist",
    "productName": "ONLYOFFICE ACP Assist",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "build/icon-256.png",
      "build/icon.ico",
      "!test/**",
      "!spike/**",
      "!bridge-plugin/**",
      "!scripts/**"
    ],
    "extraResources": [
      {
        "from": "acp-bridge.plugin",
        "to": "acp-bridge.plugin"
      }
    ],
    "icon": "build/icon.ico",
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "Office",
      "icon": "build/icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Office",
      "icon": "build/icon-256.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.4.0",
    "@acp-assist/core": "*",
    "@acp-assist/panel": "*",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  }
}